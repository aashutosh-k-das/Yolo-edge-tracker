# Configuration for the boot service (deploy/service/yolo-tracker.service).
# Edit, then: sudo systemctl restart yolo-tracker
WEIGHTS=weights/yolo_custom_fp16.engine
SOURCE=csi
# strftime patterns give each boot its own log file. Avoid --save for 24/7 runs: video fills the SD card.
EXTRA_ARGS=--reid --track-buffer 60 --stream-port 8080 --save-txt logs/tracks_%Y%m%d_%H%M%S.txt
# numpy on JetPack 4.6 can crash with "Illegal instruction" without this
OPENBLAS_CORETYPE=ARMV8
PYTHONUNBUFFERED=1
